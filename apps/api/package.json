{
  "name": "@dowze/api",
  "version": "2.22.0",
  "private": true,
  "description": "Backend NestJS de Dowze (l'intra-core) : graphe de compétences, pont .json, progression, planning.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/deepseek": "^0.2.0",
    "@ai-sdk/google": "^1.2.0",
    "@ai-sdk/mistral": "^1.2.0",
    "@ai-sdk/openai": "^1.3.0",
    "@dowze/core": "*",
    "@dowze/schemas": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "ai": "^4.3.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "jsonrepair": "^3.12.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-fsrs": "^5.2.1",
    "uid": "2.0.2",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
