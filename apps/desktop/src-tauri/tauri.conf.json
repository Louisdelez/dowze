{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dowze",
  "version": "0.1.0",
  "identifier": "ch.dowze.academie.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "https://academie.dowze.ch"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dowze",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Dowze Académie — apprentissage sans plafond",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
