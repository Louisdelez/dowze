{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai-panel",
  "description": "Panneau IA (ChatGPT/Claude) : autorise la webview 'ai' à remonter la conversation à Dowze.",
  "webviews": ["ai"],
  "remote": {
    "urls": [
      "https://chatgpt.com",
      "https://*.chatgpt.com",
      "https://*.openai.com",
      "https://claude.ai",
      "https://*.claude.ai",
      "https://*.anthropic.com"
    ]
  },
  "permissions": ["core:default", "core:event:allow-emit", "core:event:allow-listen"]
}
