{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacités de la fenêtre principale + autorisation des commandes locales (outils) depuis le frontend Dowze distant.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://academie.dowze.ch", "https://*.dowze.ch"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized"
  ]
}
