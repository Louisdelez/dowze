[Unit]
Description=Dowze local natural French voice (Pocket TTS)
After=network-online.target

[Service]
Type=simple
User=louisdelez
ExecStart=/home/louisdelez/.local/share/dowze/pocket-tts-venv/bin/pocket-tts serve --host 0.0.0.0 --port 8001 --language french_24l --quantize
Restart=unless-stopped
RestartSec=3

[Install]
WantedBy=multi-user.target
