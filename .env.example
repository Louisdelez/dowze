# ─────────────────────────────────────────────────────────────
#  Dowze — variables d'environnement (exemple)
#  Copier en `.env` (NE JAMAIS committer le `.env` réel).
#  Les valeurs ci-dessous sont celles par défaut de `supabase start` (local).
# ─────────────────────────────────────────────────────────────

# ── Supabase (local) ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=                       # affiché par `supabase start`
SUPABASE_SERVICE_ROLE_KEY=               # BACKEND UNIQUEMENT — jamais côté navigateur
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Web (Next.js) ── (les NEXT_PUBLIC_* sont exposées au navigateur)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# ── API (NestJS) ──
API_PORT=3001
REDIS_URL=redis://127.0.0.1:6379

# ── Copilote (IA interne orchestratrice) ──
# Clés des fournisseurs pour le mode « crédits ». Chaque clé absente désactive
# simplement ce fournisseur en mode crédits (le mode BYOK utilise la clé de l'élève).
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Chiffrement des clés BYOK au repos (AES-256-GCM). Générer : openssl rand -base64 32
COPILOTE_SECRET_KEY=
# Jeton d'admin pour créditer un solde (en attendant Stripe). Générer : openssl rand -hex 24
COPILOTE_ADMIN_TOKEN=

# ── Observabilité (OPTIONNELLE — no-op si vide) ──
# Traces : définir l'endpoint ET installer @opentelemetry/sdk-node.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Erreurs : définir le DSN ET installer @sentry/node.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
